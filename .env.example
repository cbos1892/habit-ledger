# Public Supabase values used by the Next.js browser and SSR clients.
# Local: copy this file to .env.local and replace the key placeholder.
# Preview/Production: configure these same names in Vercel environment settings.
NEXT_PUBLIC_SUPABASE_URL=https://jlxfxysadkbzcfpdjttq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only HMAC secret for the signed, user-bound time-zone fast-path cookie.
# Generate a unique value with: openssl rand -base64 32
TIME_ZONE_COOKIE_SECRET=replace_with_at_least_32_random_characters

# Never add a Supabase secret key, service-role key, database password, or
# personal access token to a NEXT_PUBLIC_* variable or commit its real value.
